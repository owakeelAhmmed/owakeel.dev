# src/
# ├── assets/             # All static files (images, fonts, etc.)
# ├── components/         # Reusable UI components
# │   ├── ui/             # shadcn/ui custom components (Button, Input, etc.)
# │   └── shared/         # Navbar, Footer, ThemeToggle etc.
# ├── pages/              # Page components (Home, About, Contact etc.)
# │   ├── Home.tsx
# │   ├── About.tsx
# │   ├── Projects.tsx
# │   ├── Contact.tsx
# │   └── NotFound.tsx
# ├── routes/             # All routes (centralized route management)
# │   └── AppRoutes.tsx
# ├── layouts/            # Layouts (e.g., DefaultLayout with Navbar+Footer)
# │   └── MainLayout.tsx
# ├── hooks/              # Custom hooks if any
# ├── lib/                # Utility functions, theme configs
# ├── constants/          # Static data like social links, skills etc.
# ├── App.tsx             # Main app file with routing
# ├── main.tsx            # Entry point
# └── index.css           # Tailwind + shadcn styles




